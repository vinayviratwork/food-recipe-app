# ============================================================
# Food Recipe App — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to version control.
# ============================================================

# Node environment: development | production | test
NODE_ENV=development

# Server
PORT=5000

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/food-recipe-app
# Atlas:   mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/food-recipe-app
MONGO_URI=mongodb://127.0.0.1:27017/food-recipe-app

# JWT — use a long, random string (e.g., openssl rand -hex 64)
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
